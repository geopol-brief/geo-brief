---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0">
<channel>
  <title>{{ site.title }} / {{ site.titleEn }}</title>
  <link>{{ site.url }}/</link>
  <description>{{ site.description | xmlEscape }}</description>
  <language>ko</language>
  {% for p in collections.posts | head(30) %}
  <item>
    <title>{{ p.data.title | xmlEscape }}{% if p.data.title_en %} / {{ p.data.title_en | xmlEscape }}{% endif %}</title>
    <link>{{ site.url }}{{ p.url }}</link>
    <guid>{{ site.url }}{{ p.url }}</guid>
    <pubDate>{{ p.date | rfc822 }}</pubDate>
    <description>{{ p.data.summary | xmlEscape }}</description>
  </item>
  {% endfor %}
</channel>
</rss>
