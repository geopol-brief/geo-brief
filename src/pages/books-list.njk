  <div class="list">
    {% for p in collections.books %}{{ row(p) }}{% else %}
      <p class="empty bi"><span class="ko">아직 독후감이 없습니다.</span><span class="en">No book reviews yet.</span></p>
    {% endfor %}
  </div>
</main>
